# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Email Configuration
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com

# Pricing Monitor Configuration
HISTORY_PATH=data/udacity_prices.csv
ALERTS_PATH=data/udacity_alerts.csv

# Alert Thresholds
MIN_HISTORY_POINTS=5
LOOKBACK_DAYS=180
DROP_PCT_THRESHOLD=0.25
Z_SCORE_THRESHOLD=1.25
MIN_VALID_PRICE=50
ALERT_COOLDOWN_DAYS=7
